amends "https://sake92.github.io/deder/config/v0.11.1/DederProject.pkl"

local const baseTemplate: ScalaModule = new {
  scalaVersion = "2.13.18"
  publish = false
}

local const regenescaModules =
  new CreateScalaModules {
    root = "regenesca"
    template = (baseTemplate) {
      deps {
        "ch.epfl.scala::scalafix-core:0.14.2"
      }
      publish = true
      pomSettings {
        groupId = "ba.sake"
        artifactId = "regenesca"
        name = "Regenesca library"
        description = "Regenesca library - Refactoring Generator of Source Code for Scala"
        url = "https://github.com/sake92/regenesca"
        licenses {
          new PomLicense {
            name = "Apache 2.0 License"
            url = "https://www.apache.org/licenses/LICENSE-2.0"
          }
        }
        developers {
          new PomDeveloper {
            id = "sake92"
            name = "Sakib Hadžiavdić"
            email = "sake92@sake.ba"
          }
        }
        scm {
          url = "https://github.com/sake92/regenesca"
          connection = "scm:git:git://github.com/sake92/regenesca.git"
        }
      }
      publishTo = new SonatypeCentralRepo { id = "sonatype" }
    }
    testTemplate = (baseTemplate.asTest()) {
      deps {
        "org.scalameta::munit:1.0.1"
      }
    }
  }.get

local const hello: ScalaModule = (baseTemplate) {
  id = "helloExample"
  root = "examples/hello"
  moduleDeps {
    regenescaModules.main
  }
}

local const migration: ScalaModule = (baseTemplate) {
  id = "migrationExample"
  root = "examples/migration"
  moduleDeps {
    regenescaModules.main
  }
}

modules {
  ...regenescaModules.all
  hello
  migration
}
